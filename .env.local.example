# ============================================
# D'Ele Services - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control!

# --------------------------------------------
# Web3Forms Configuration (REQUIRED)
# --------------------------------------------
# 1. Go to https://web3forms.com/
# 2. Sign up for a free account (unlimited submissions)
# 3. Create a new form
# 4. Copy your Access Key
# 5. Paste it below (replace "your_access_key_here")
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# --------------------------------------------
# Site Configuration
# --------------------------------------------
# For development (default)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For production (uncomment and update when deploying)
# NEXT_PUBLIC_SITE_URL=https://deleservices.ca

# --------------------------------------------
# Google Analytics (OPTIONAL)
# --------------------------------------------
# Get your GA4 Measurement ID from Google Analytics
# Format: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=

# --------------------------------------------
# Important Notes:
# --------------------------------------------
# - Free Web3Forms plan includes unlimited submissions
# - Emails will be sent to: deleservices.ca@gmail.com (configured in constants.ts)
# - Form submissions redirect to: /thank-you
# - NEXT_PUBLIC_ prefix makes variables available in the browser
